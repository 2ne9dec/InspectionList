# ============================================================================
# Пример env-файла. Скопируйте в .env.local для локальной разработки
# и в .env.production для боевой сборки.
# ============================================================================

# Базовый URL API (json-server для dev / реальный сервер для prod)
VITE_API_URL=http://localhost:8443

# Версия приложения (для логов / Sentry)
VITE_APP_VERSION=1.0.0

# Имя проекта (frontend / storybook)
VITE_PROJECT=frontend
