# ── Сервер ────────────────────────────────────────────────────────────────────
PORT=80

# ── Firebird ──────────────────────────────────────────────────────────────────
# Если Express и Firebird на одной машине — оставь 127.0.0.1
# Если Firebird на другой машине — укажи её IP-адрес
FB_HOST=127.0.0.1
FB_PORT=3050

# Полный путь к файлу базы данных на том компьютере где стоит Firebird
# У каждого филиала своя база (номер = ID филиала): после входа пользователь
# работает с базой своего филиала.
FB_DATABASE_1=C:\webProjects\2026\InspectionList\db\gomel.fdb
FB_DATABASE_2=C:\webProjects\2026\InspectionList\db\zhlobin.fdb
FB_DATABASE_3=C:\webProjects\2026\InspectionList\db\mozyr.fdb
FB_DATABASE_4=C:\webProjects\2026\InspectionList\db\rechitsa.fdb
# Отдельная база пользователей (логины, хеши паролей, роли, права). С листками и дефектами
# не связана. Создаётся сервером при первом запуске, пользователи переносятся из баз филиалов.
FB_DATABASE_USERS=C:\webProjects\2026\InspectionList\db\users.fdb

# Пользователь и пароль Firebird (по умолчанию SYSDBA / masterkey)
FB_USER=SYSDBA
FB_PASSWORD=masterkey

# ── JWT ───────────────────────────────────────────────────────────────────────
# Секретный ключ для токенов — сгенерировать можно так:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=7016fd03f8a8813b696ca4b02b8b60abcfbfe5a5259fcbc8b78f221a2e2861af
JWT_EXPIRES=8h

# ── CORS (в production укажи реальный адрес) ──────────────────────────────────
# Пример: ALLOWED_ORIGINS=http://10.180.160.167:80
# В dev оставь пустым — автоматически разрешится localhost:5173
# ALLOWED_ORIGINS=http://10.180.160.167:80

# ── Привязка к IP ────────────────────────────────────────────────────────────
# Dev: оставь закомментированным (сервер слушает 0.0.0.0)
# Prod: раскомментируй и укажи реальный IP сервера
# BIND_HOST=10.180.160.167
