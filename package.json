{
  "name": "line-vision",
  "version": "1.0.0",
  "description": "Листки осмотра",
  "scripts": {
    "start": "concurrently \"vite\" \"yarn server\"",
    "server": "node ./json-server/index.js",
    "build": "tsc && vite build",
    "lint:ts": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:ts:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
