# URL бэкенда для Vite dev-сервера (yarn start).
# Должен совпадать с адресом, на котором слушает server/index.js (BIND_HOST + PORT).
# Ноутбук разработки: сервер запускается здесь же (yarn start) на порту из server/.env (PORT=80)
# и работает с локальными базами всех филиалов из папки db.
# Рабочий сервер на другом ПК: VITE_API_URL=http://10.180.160.167
VITE_API_URL=http://localhost

# ID филиала для сборки планшета (вход без сети) (1=Гомель, 2=Жлобин, 3=Мозырь, 4=Речица).
# На вход через сервер не влияет: там филиал выбирается на странице входа.
VITE_FILIAL_ID=2
